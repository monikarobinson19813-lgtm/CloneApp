<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:label="CA Test App"
        android:theme="@style/Theme.CATest">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".ControlledStateService"
            android:exported="false" />
        <receiver
            android:name=".ControlledStateReceiver"
            android:exported="false" />
        <provider
            android:name=".ControlledStateProvider"
            android:authorities="com.cloneapp.testapp.state"
            android:exported="true" />
    </application>
</manifest>
